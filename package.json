{
  "name": "astro-split-build",
  "version": "0.1.0",
  "description": "Build a large multi-locale static site one target at a time, merge the outputs into one directory, and fail on broken asset references, broken internal links and your own page checks.",
  "keywords": [
    "astro",
    "i18n",
    "static-site",
    "build",
    "multilingual",
    "locales",
    "out-of-memory",
    "broken-links",
    "hreflang"
  ],
  "homepage": "https://github.com/spokospace/astro-split-build#readme",
  "bugs": {
    "url": "https://github.com/spokospace/astro-split-build/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spokospace/astro-split-build.git"
  },
  "license": "MIT",
  "author": {
    "name": "spokospace",
    "email": "szymon@spoko.space",
    "url": "https://spoko.space"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "bin": {
    "astro-split-build": "./src/cli.js"
  },
  "files": [
    "src",
    "types",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "npm run build:types && tsc -p test/types",
    "build:types": "tsc -p .",
    "prepare": "npm run build:types"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "6.0.3"
  }
}
